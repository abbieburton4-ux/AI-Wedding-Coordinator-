# Databases: async for FastAPI, sync for Alembic/seeding
# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./venueflow.db
SYNC_DATABASE_URL=sqlite:///./venueflow.db

# For PostgreSQL (production or local Docker compose):
# DATABASE_URL=postgresql+asyncpg://venueflow:venueflow_pass@db/venueflow
# SYNC_DATABASE_URL=postgresql+psycopg2://venueflow:venueflow_pass@db/venueflow

# API Keys & Auth
# NOTE: this is an EXAMPLE file. Never commit a real key here — put real values
# in a local .env (gitignored). Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# The couple's own Firebase project id (docs/setup-sign-in.md). Not needed for mock sign-in.
# FIREBASE_PROJECT_ID=
# Shared secrets; only needed outside DEVELOPMENT_MODE. Generate long random values.
# INTERNAL_TASKS_SECRET=
# INBOUND_EMAIL_SECRET=

# ElevenLabs Conversational AI — the "Aurelia" voice agent. Server-side secret;
# leave unset to disable the voice option (the /voice/token endpoint returns 503).
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_AGENT_ID=agent_3801ktczgph3ep3bpr0rp9jgvzqc

# Dev settings
DEVELOPMENT_MODE=True
ALLOW_MOCK_AUTH=True
# Emails allowed to create the first account before the access list exists. Leave
# empty locally; set it only in the deployed environment.
# ACCESS_BOOTSTRAP_EMAILS=


# Cloud Tasks
TASKS_EMULATOR_HOST=localhost
TASKS_EMULATOR_PORT=8123
PROJECT_ID=venueflow-dev
LOCATION=europe-west1
QUEUE_ID=agent-tasks
