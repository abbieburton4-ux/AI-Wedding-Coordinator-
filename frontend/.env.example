# Frontend environment (Vite). Copy to .env for local overrides.
# Only VITE_-prefixed vars are exposed to the browser.

# Base URL of the FastAPI backend.
# Local Docker stack publishes it on the host at:
VITE_API_URL=http://localhost:8000

# --- Firebase Auth (PRODUCTION) ---
# Leave these UNSET for local development — the app then runs in dev-auth mode
# (a dev identity picker that uses mock- tokens, so no Firebase is required).
# Set them in production to enable real email/password + Google sign-in.
# These values are public (client config), not secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
