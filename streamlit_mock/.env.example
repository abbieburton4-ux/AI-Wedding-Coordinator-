# VenueFlow pilot — local environment template.
#
# Copy this file to .env.local (which is gitignored) and fill in YOUR OWN
# personal keys. Do not share keys between founders — each founder uses
# their own test-mode keys for local dev. Production keys live in Google
# Secret Manager, not in any .env file.
#
# Loading: this file is read by python-dotenv if you wire it, or you can
# `export $(grep -v '^#' .env.local | xargs)` before launching Streamlit.

# ─── Gemini ───────────────────────────────────────────────────────────────
# Personal Gemini API key from https://aistudio.google.com/apikey
# Free tier (15 req/min) is enough for local dev. Production uses a service
# account, not a personal key.
GEMINI_API_KEY=

# ─── Stripe (lands Week 2, leave blank for now) ───────────────────────────
# Test mode only for local dev. Live keys never go in .env files — they
# live in Google Secret Manager and are injected into Cloud Run at runtime.
# Get test keys from https://dashboard.stripe.com/test/apikeys (Developer
# role required; ask Alan to grant access if you don't see the menu).
STRIPE_SECRET_KEY=          # sk_test_...
STRIPE_PUBLISHABLE_KEY=     # pk_test_...
STRIPE_WEBHOOK_SECRET=      # whsec_... — generated when you create a webhook endpoint

# ─── Optional: override DB path for parallel test runs ────────────────────
# VENUEFLOW_DB_PATH=
